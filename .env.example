# Copy this file to .env and replace every CHANGE_ME value.
# Local development only. Never reuse these credentials in another environment.

COMPOSE_PROJECT_NAME=order-logistics

# Published ports are bound to 127.0.0.1 by docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
KAFKA_UI_PORT=8081
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PRODUCT_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084

# PostgreSQL bootstrap administrator. Used only for initialization and diagnostics.
POSTGRES_SUPERUSER=platform_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_postgres_admin_32_chars

# Database names and least-privilege application principals.
GATEWAY_DB_NAME=gateway_db
GATEWAY_DB_USER=gateway_app
GATEWAY_DB_PASSWORD=CHANGE_ME_gateway_db_32_chars

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=CHANGE_ME_identity_db_32_chars

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_app
PRODUCT_DB_PASSWORD=CHANGE_ME_product_db_32_chars

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=CHANGE_ME_inventory_db_32_chars

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=CHANGE_ME_order_db_32_chars

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_app
PAYMENT_DB_PASSWORD=CHANGE_ME_payment_db_32_chars

DELIVERY_DB_NAME=delivery_db
DELIVERY_DB_USER=delivery_app
DELIVERY_DB_PASSWORD=CHANGE_ME_delivery_db_32_chars

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notification_db_32_chars

KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_32_chars

MONITORING_DB_USER=monitoring_app
MONITORING_DB_PASSWORD=CHANGE_ME_monitoring_db_32_chars

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_32_chars

# Keycloak bootstrap administrator and local-only test identities.
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_32_chars
KEYCLOAK_CUSTOMER_PASSWORD=CHANGE_ME_customer_32_chars
KEYCLOAK_STAFF_PASSWORD=CHANGE_ME_staff_32_chars

# Grafana local administrator.
GRAFANA_ADMIN_USER=local-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_32_chars
